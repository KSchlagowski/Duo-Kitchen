---
import { cn } from "@/lib/utils";
import { formatMealTypes, DIVISION_MODE_LABELS } from "@/lib/recipe-labels";
import type { RecipeCard } from "@/types";

interface Props {
  recipe: RecipeCard;
}

const { recipe } = Astro.props;

// No photo column yet: a placeholder gradient picked deterministically from the cuisine, so the
// same cuisine always gets the same colour.
const PLACEHOLDER_GRADIENTS = [
  "from-amber-400/40 to-rose-500/40",
  "from-emerald-400/40 to-cyan-500/40",
  "from-sky-400/40 to-indigo-500/40",
  "from-fuchsia-400/40 to-purple-500/40",
  "from-lime-400/40 to-emerald-600/40",
  "from-orange-400/40 to-red-500/40",
];
let hash = 0;
for (let i = 0; i < recipe.cuisine.length; i++) {
  hash = (hash * 31 + recipe.cuisine.charCodeAt(i)) >>> 0;
}
const gradient = PLACEHOLDER_GRADIENTS[hash % PLACEHOLDER_GRADIENTS.length];
const initial = recipe.name.charAt(0).toUpperCase();
const href = `/recipes/${recipe.id}`;
---

<article
  class="flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-white/10 text-white backdrop-blur-xl"
  data-testid="recipe-card"
>
  <a href={href} class="block aspect-[4/3] w-full" tabindex="-1" aria-hidden="true">
    {recipe.photoUrl ? (
      <img src={recipe.photoUrl} alt="" class="h-full w-full object-cover" loading="lazy" />
    ) : (
      <div
        class:list={cn(
          "flex h-full w-full items-center justify-center bg-gradient-to-br text-5xl font-bold text-white/70",
          gradient,
        )}
      >
        {initial}
      </div>
    )}
  </a>
  <div class="flex flex-1 flex-col gap-1 p-4">
    <h2 class="text-lg leading-tight font-semibold">
      <a href={href} class="hover:underline">
        {recipe.name}
      </a>
    </h2>
    <p class="text-sm text-blue-100/80">
      {recipe.cuisine} · {recipe.prepMinutes} min
    </p>
    <p class:list={cn("text-xs", recipe.mealTypes.length ? "text-blue-100/70" : "text-blue-100/50")}>
      {formatMealTypes(recipe.mealTypes)}
    </p>
    {recipe.divisionMode === "whole_dish" && (
      <span class="mt-1 self-start rounded-full border border-white/20 px-2 py-0.5 text-xs text-blue-100/80">
        {DIVISION_MODE_LABELS.whole_dish}
      </span>
    )}
    {/* Seam for ratings (S-06): the page fills it with slot="ratings"; nothing renders until then. */}
    {Astro.slots.has("ratings") && (
      <div data-slot="ratings" class="mt-2">
        <slot name="ratings" />
      </div>
    )}
  </div>
</article>
