---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { getCurrentHousehold } from "@/lib/services/household";
import { INVITE_CODE_PATTERN, readInviteCookie, setInviteCookie } from "@/lib/invite-cookie";

// Deliberately NOT in middleware.ts's PROTECTED_ROUTES: besides sign-in and sign-up, this is the one
// page an unauthenticated visitor may reach (PRD §Access Control).
const { user } = Astro.locals;

// The query wins, so a fresh link always overrides a stale cookie. The cookie is the fallback that
// survives the sign-up -> confirm-email -> sign-in detour. An empty `?code=` is normalised to null
// first, so it falls through to the cookie instead of shadowing a good code with an empty one.
const rawQueryCode = Astro.url.searchParams.get("code");
const queryCode = rawQueryCode !== null && rawQueryCode !== "" ? rawQueryCode : null;
const code = queryCode ?? readInviteCookie(Astro.cookies);
// Only a well-formed code is persisted; a malformed one still renders below, where the redeem route's
// zod schema rejects it with a readable message.
if (queryCode !== null && INVITE_CODE_PATTERN.test(queryCode)) {
  setInviteCookie(Astro.cookies, queryCode);
}

// redeem_household_invite() refuses an already-linked caller (KD008), because moving them would leave
// their partner alone in the shared household with no way back. Ask here too, so the page explains
// that instead of offering a button that cannot work.
let alreadyLinked = false;
if (user) {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (supabase) {
    try {
      const household = await getCurrentHousehold(supabase);
      alreadyLinked = (household?.members.length ?? 0) >= 2;
    } catch (error) {
      // eslint-disable-next-line no-console -- surfaced in Cloudflare Workers observability logs
      console.error("getCurrentHousehold failed on /join", error);
    }
  }
}

const error = Astro.url.searchParams.get("error");
---

<Layout title="Join a household">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
      <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        Join a household
      </h1>

      {error && <p class="mb-4 rounded-lg border border-red-400/30 bg-red-500/10 p-3 text-sm text-red-200">{error}</p>}

      {!code ? (
        <p class="text-sm text-blue-100/80" data-testid="join">
          This invite link is incomplete.
        </p>
      ) : !user ? (
        <>
          {/* No inviter identity is shown: households have no name and clients cannot read auth.users. */}
          <p class="text-sm text-blue-100/80" data-testid="join">
            You've been invited to share a household.
          </p>
          <p class="mt-4 text-sm text-blue-100/60">
            <a href="/auth/signin" class="text-purple-300 hover:underline">
              Sign in
            </a>
            {" or "}
            <a href="/auth/signup" class="text-purple-300 hover:underline">
              create an account
            </a>
            {" to continue."}
          </p>
        </>
      ) : alreadyLinked ? (
        <p class="text-sm text-blue-100/80" data-testid="join">
          You're already linked with a partner, so this invite can't be accepted. Leaving a shared household isn't
          supported yet.
        </p>
      ) : (
        <>
          <p class="text-sm text-blue-100/80" data-testid="join">
            You've been invited to share a household. Joining moves your account into it.
          </p>
          {/*
              A deliberate POST, never a one-click GET: redemption cannot be undone by any
              application path in this slice, so it must be an explicit act.
            */}
          <form method="POST" action="/api/household/redeem" class="mt-6">
            <input type="hidden" name="code" value={code} />
            <button
              type="submit"
              class="w-full rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
            >
              Join this household
            </button>
          </form>
        </>
      )}
    </div>
  </div>
</Layout>
