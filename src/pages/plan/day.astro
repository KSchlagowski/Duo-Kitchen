---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import {
  DAY_BOUNDS_WARNING,
  DAY_NOT_FOUND,
  DAY_SOLVE_STALE,
  DAY_UNAVAILABLE,
  FULL_TARGETS_NOTE,
  NOT_SOLVED_YET,
  formatCookDayNote,
  formatDaySolveSummary,
  formatEaters,
  formatFromBatchNote,
  formatGroupSolveNote,
  formatPersonLine,
  formatSameDayBatchNote,
  formatSolvedAt,
  formatSplitLine,
  formatTargetLine,
  getDayView,
  unsolvableMessage,
  viewerFirst,
} from "@/lib/services/day-solutions";
import { addDays, isIsoDate, weekdayLabel } from "@/lib/services/meal-plans";
import { formatIngredientAmount } from "@/lib/services/recipe-macros";
import { MEAL_TYPE_LABELS } from "@/lib/recipe-labels";
import { cn } from "@/lib/utils";
import type { DaySolutionMeal, DayView, PlanDayIndex } from "@/types";

// S-04: one plan day's STORED macro solve, and the forms that solve or accept it. The page never
// computes a result it does not store; staleness is a fingerprint comparison (getDayView).
// A malformed start/day or a date with no saved plan is 404; a failed read is 500.
type State = { kind: "not-found" } | { kind: "unavailable" } | { kind: "loaded"; view: DayView };

const viewerId = Astro.locals.user?.id ?? "";
const startParam = Astro.url.searchParams.get("start") ?? "";
const dayParam = Astro.url.searchParams.get("day") ?? "";
const dayIndex = (["0", "1", "2"] as const).includes(dayParam as "0" | "1" | "2")
  ? (Number(dayParam) as PlanDayIndex)
  : null;

let state: State = { kind: "not-found" };
if (isIsoDate(startParam) && dayIndex !== null) {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase) {
    state = { kind: "unavailable" };
  } else {
    try {
      const view = await getDayView(supabase, startParam, dayIndex);
      if (view) {
        state = { kind: "loaded", view };
      }
    } catch (error) {
      state = { kind: "unavailable" };
      // eslint-disable-next-line no-console -- surfaced in Cloudflare Workers observability logs
      console.error("getDayView failed on /plan/day", error);
    }
  }
}

if (state.kind === "not-found") {
  Astro.response.status = 404;
} else if (state.kind === "unavailable") {
  Astro.response.status = 500;
}

const date = dayIndex !== null && isIsoDate(startParam) ? addDays(startParam, dayIndex) : null;
const heading = date ? `${weekdayLabel(date)} ${date}` : "Day";
const view = state.kind === "loaded" ? state.view : null;
const stored = view?.stored ?? null;
const solution = stored?.solution ?? null;
const stale = view?.stale ?? false;
const unsolvable = view?.unsolvable ?? null;
const missingOwnTargets =
  unsolvable !== null && unsolvable.reason === "missing_targets" && (unsolvable.userIds?.includes(viewerId) ?? false);
// Accepting is offered only for the exact result on screen, and never for an out-of-date one.
const acceptTier =
  stored !== null && !stale && stored.status === "needs_confirmation" ? stored.solution.requiredTier : null;

// S-08: a day that shares a batch with another day solves, stores and goes stale with it.
const weekdayOf = (day: PlanDayIndex) => (isIsoDate(startParam) ? weekdayLabel(addDays(startParam, day)) : "");
const otherGroupDays = view && dayIndex !== null ? view.groupDayIndexes.filter((day) => day !== dayIndex) : [];
const groupSolveNote = otherGroupDays.length > 0 ? formatGroupSolveNote(otherGroupDays.map(weekdayOf)) : null;
const mealTypeOf = (mealId: string) => solution?.meals.find((meal) => meal.mealId === mealId)?.mealType;

// A shared batch's note: on its cook day the days its other portions are for; on any other day
// the day it was cooked on. Null for a batch cooked for this meal alone.
function batchNoteOf(meal: DaySolutionMeal): string | null {
  if (meal.batch === null || dayIndex === null) return null;
  if (meal.batch.cookDayIndex !== dayIndex) return formatFromBatchNote(weekdayOf(meal.batch.cookDayIndex));
  const days = new Set(meal.components.flatMap((c) => c.split.shares.map((share) => share.dayIndex)));
  const otherDays = ([0, 1, 2] as const).filter((day) => day !== dayIndex && days.has(day));
  if (otherDays.length > 0) return formatCookDayNote(otherDays.map(weekdayOf));
  const otherMeals = meal.batch.mealIds.filter((id) => id !== meal.mealId).map(mealTypeOf);
  return formatSameDayBatchNote(otherMeals.flatMap((type) => (type ? [MEAL_TYPE_LABELS[type]] : [])));
}

const solved = Astro.url.searchParams.get("solved") === "1";
const notice = Astro.url.searchParams.get("error");

const buttonClass =
  "rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20";
---

<Layout title={`Macros · ${heading}`}>
  <div class="bg-cosmic min-h-screen p-4 sm:p-8">
    <div class="mx-auto max-w-3xl rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl sm:p-8">
      <h1 class="mb-1 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Macros
      </h1>
      <p class="mb-4 text-sm text-blue-100/80">{heading}</p>

      {solved && (
        <p class="mb-4 rounded-lg border border-emerald-400/30 bg-emerald-500/10 p-3 text-sm text-emerald-200">
          Solved.
        </p>
      )}
      {notice && (
        <p class="mb-4 rounded-lg border border-red-400/30 bg-red-500/10 p-3 text-sm text-red-200">{notice}</p>
      )}

      {state.kind === "not-found" && (
        <p class="text-center text-lg" data-testid="day-not-found">
          {DAY_NOT_FOUND}
        </p>
      )}
      {state.kind === "unavailable" && (
        <p class="text-center text-lg" data-testid="day-unavailable">
          {DAY_UNAVAILABLE}
        </p>
      )}
      {unsolvable && (
        <p
          class="mb-4 rounded-lg border border-amber-400/30 bg-amber-500/10 p-3 text-sm text-amber-100"
          data-testid="day-unsolvable"
        >
          {unsolvableMessage(unsolvable, viewerId)}
          {missingOwnTargets && (
            <>
              {" "}
              <a href="/targets" class="text-purple-300 hover:underline">
                Set targets
              </a>
            </>
          )}
        </p>
      )}

      {view && stale && (
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-amber-400/30 bg-amber-500/10 p-3">
          <p class="text-sm text-amber-100" data-testid="day-solve-stale">
            {DAY_SOLVE_STALE}
          </p>
          {groupSolveNote && !unsolvable && <p class="text-xs text-amber-100/80">{groupSolveNote}</p>}
          {!unsolvable && (
            <form method="POST" action="/api/plan/solve">
              <input type="hidden" name="start_date" value={startParam} />
              <input type="hidden" name="day_index" value={dayParam} />
              <button type="submit" class:list={buttonClass}>
                Solve again
              </button>
            </form>
          )}
        </div>
      )}

      {view && !stored && !unsolvable && (
        <section class="flex flex-col items-start gap-3">
          <p class="text-lg font-semibold" data-testid="day-solve-summary">
            {NOT_SOLVED_YET}
          </p>
          {groupSolveNote && (
            <p class="text-xs text-blue-100/60" data-testid="day-group-note">
              {groupSolveNote}
            </p>
          )}
          <form method="POST" action="/api/plan/solve">
            <input type="hidden" name="start_date" value={startParam} />
            <input type="hidden" name="day_index" value={dayParam} />
            <button type="submit" class:list={buttonClass}>
              Solve macros
            </button>
          </form>
        </section>
      )}

      {stored && solution && (
        <div class:list={cn(stale && "opacity-50")}>
          <p class="text-lg font-semibold" data-testid="day-solve-summary">
            {formatDaySolveSummary(solution, stored.status, viewerId)}
          </p>
          <p class="text-xs text-blue-100/60">{formatSolvedAt(stored.solvedAt)}</p>
          {solution.boundsViolated && (
            <p
              class="mt-3 rounded-lg border border-amber-400/30 bg-amber-500/10 p-3 text-sm text-amber-100"
              data-testid="day-bounds-warning"
            >
              {DAY_BOUNDS_WARNING}
            </p>
          )}

          {!stale && groupSolveNote && (
            <p class="mt-3 text-xs text-blue-100/60" data-testid="day-group-note">
              {groupSolveNote}
            </p>
          )}
          {!stale && (
            <div class="mt-3 flex flex-wrap gap-2">
              {acceptTier !== null && (
                <form method="POST" action="/api/plan/solve">
                  <input type="hidden" name="start_date" value={startParam} />
                  <input type="hidden" name="day_index" value={dayParam} />
                  <input type="hidden" name="accept_tolerance" value={String(acceptTier)} />
                  <input type="hidden" name="fingerprint" value={stored.inputFingerprint} />
                  <button type="submit" class:list={buttonClass}>
                    Accept ±{acceptTier}%
                  </button>
                </form>
              )}
              <form method="POST" action="/api/plan/solve">
                <input type="hidden" name="start_date" value={startParam} />
                <input type="hidden" name="day_index" value={dayParam} />
                <button type="submit" class:list={buttonClass}>
                  Solve again
                </button>
              </form>
            </div>
          )}

          <section class="mt-4 flex flex-col gap-2">
            {viewerFirst(solution.people, viewerId).map((person) => (
              <div class="rounded-xl border border-white/10 bg-white/5 p-3">
                <p
                  class="text-sm"
                  data-testid="day-person"
                  data-person={person.userId === viewerId ? "you" : "partner"}
                >
                  {formatPersonLine(person, viewerId)}
                </p>
                <p class="text-xs text-blue-100/60">{formatTargetLine(person)}</p>
              </div>
            ))}
            <p class="text-xs text-blue-100/60">{FULL_TARGETS_NOTE}</p>
          </section>

          {solution.meals.map((meal) => {
            const batchNote = batchNoteOf(meal);
            // A batch cooked on another day: its amounts belong to that day's page. Here only the
            // note and the portions (the stored jsonb still carries the full batch on both days).
            const cookedElsewhere = meal.batch !== null && meal.batch.cookDayIndex !== dayIndex;
            return (
              <section class="mt-4 rounded-xl border border-white/10 bg-white/5 p-4">
                <h2 class="font-semibold">
                  <a href={`/recipes/${meal.recipeId}`} class="hover:underline">
                    {meal.recipeName}
                  </a>
                </h2>
                <p class="mb-2 text-xs text-blue-100/70">
                  {MEAL_TYPE_LABELS[meal.mealType]} · {formatEaters(meal, viewerId)}
                </p>
                {batchNote && (
                  <p class="mb-2 text-sm text-amber-100" data-testid={`day-batch-${meal.mealType}`}>
                    {batchNote}
                  </p>
                )}
                {meal.components.map((component) => (
                  <div class="mt-2 border-t border-white/10 pt-2">
                    {meal.divisionMode === "per_component" && <h3 class="text-sm font-medium">{component.name}</h3>}
                    {!cookedElsewhere && (
                      <ul class="mt-1 space-y-0.5 text-sm">
                        {component.ingredients.map((ingredient) => (
                          <li>
                            <span class="text-white">{ingredient.productName}</span>
                            <span class="text-blue-100/80">
                              {" "}
                              {formatIngredientAmount(
                                ingredient.amountG,
                                ingredient.gramsPerPiece,
                                ingredient.allowHalfPieces,
                              )}
                            </span>
                          </li>
                        ))}
                      </ul>
                    )}
                    <p class="mt-1 text-sm text-purple-200">
                      {formatSplitLine(
                        component,
                        viewerId,
                        dayIndex === null
                          ? undefined
                          : {
                              mealId: meal.mealId,
                              viewedDay: dayIndex,
                              weekdayOf,
                              mealTypeOf,
                              ownOnly: cookedElsewhere,
                            },
                      )}
                    </p>
                  </div>
                ))}
              </section>
            );
          })}
        </div>
      )}

      <p class="mt-8 text-center text-sm">
        <a href={isIsoDate(startParam) ? `/plan?start=${startParam}` : "/plan"} class="text-purple-300 hover:underline">
          Back to plan
        </a>
      </p>
    </div>
  </div>
</Layout>
