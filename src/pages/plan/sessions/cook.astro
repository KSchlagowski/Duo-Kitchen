---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { addDays, isIsoDate, weekdayLabel } from "@/lib/services/meal-plans";
import { getCookMode } from "@/lib/services/cooking";
import {
  COOK_BOUNDS_WARNING,
  COOK_NO_PLAN_FOR_DATE,
  COOK_NO_STEPS,
  COOK_UNAVAILABLE,
  formatCookEstimateNote,
  formatCookExactNote,
} from "@/lib/services/cook-mode";
import { formatSessionTitle } from "@/lib/services/cooking-sessions";
import CookMode from "@/components/cook/CookMode";
import { COOK_MODE_LABELS, SESSION_SECTION_LABELS, STEP_TIMING_LABELS } from "@/lib/recipe-labels";
import { cn } from "@/lib/utils";
import type { CookModeView, MealPlan, PlanDayIndex } from "@/types";

// S-11: one cooking session followed step by step, with each step's amounts and the You / Partner
// portions from the current stored solve (else the recipe base amounts as an estimate). Derived on
// every read; nothing is stored server-side. `?step=N` makes every step reachable without JavaScript;
// the CookMode island (client:idle) renders the same step card, navigation and step list, then
// switches steps in place and adds per-device done ticks and Keep screen on.
// A malformed start / session / step, or a session not in the plan, is 404; a date with no plan says
// so; a failed read is 500 — never "no plan".
type State =
  | { kind: "not-found" }
  | { kind: "unavailable" }
  | { kind: "no-plan" }
  | { kind: "loaded"; plan: MealPlan; view: CookModeView };

const viewerId = Astro.locals.user?.id ?? "";
const startParam = Astro.url.searchParams.get("start") ?? "";
const sessionParam = Astro.url.searchParams.get("session") ?? "";
const stepParam = Astro.url.searchParams.get("step");

const sessionMatch = /^(\d{4}-\d{2}-\d{2})-(morning|evening)$/.exec(sessionParam);
const valid =
  isIsoDate(startParam) &&
  sessionMatch !== null &&
  isIsoDate(sessionMatch[1]) &&
  (stepParam === null || /^[1-9]\d{0,2}$/.test(stepParam));

let state: State = { kind: "not-found" };
if (valid) {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase) {
    state = { kind: "unavailable" };
  } else {
    try {
      const loaded = await getCookMode(supabase, startParam, sessionParam, viewerId);
      if (!loaded) {
        state = { kind: "no-plan" };
      } else if (loaded.view) {
        state = { kind: "loaded", plan: loaded.plan, view: loaded.view };
      }
    } catch (error) {
      state = { kind: "unavailable" };
      // eslint-disable-next-line no-console -- surfaced in Cloudflare Workers observability logs
      console.error("getCookMode failed on /plan/sessions/cook", error);
    }
  }
}

if (state.kind === "not-found") {
  Astro.response.status = 404;
} else if (state.kind === "unavailable") {
  Astro.response.status = 500;
}

const view = state.kind === "loaded" ? state.view : null;
const startDate = isIsoDate(startParam) ? startParam : null;
const steps = view?.steps ?? [];
// A well-formed step past the end shows the last step: a plan edit can shorten an open session.
const stepNumber = Math.min(Math.max(Number(stepParam ?? "1"), 1), Math.max(steps.length, 1));
const current = steps.length > 0 ? steps[stepNumber - 1] : null;
const evening = view?.part === "evening";
const weekdayOf = (day: PlanDayIndex) => (view ? weekdayLabel(addDays(view.startDate, day)) : "");
const dayPath = (day: PlanDayIndex) => `/plan/day?start=${view?.startDate ?? ""}&day=${day}`;
const sessionsPath = view ? `/plan/sessions?start=${view.startDate}#${view.sessionKey}` : "/plan/sessions";
---

<Layout title={view ? `Cook · ${formatSessionTitle(view.date, view.part)}` : "Cook mode"}>
  <div class="bg-cosmic min-h-screen p-4 sm:p-8">
    <div class="mx-auto max-w-3xl rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl sm:p-8">
      <h1 class="mb-1 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        {view ? formatSessionTitle(view.date, view.part) : "Cook mode"}
      </h1>
      {view && <p class="mb-4 text-sm text-blue-100/80">{view.date}</p>}

      {state.kind === "not-found" && (
        <p class="text-center text-lg" data-testid="cook-not-found">
          Plan not found
        </p>
      )}
      {state.kind === "unavailable" && (
        <p class="text-center text-lg" data-testid="cook-unavailable">
          {COOK_UNAVAILABLE}
        </p>
      )}
      {state.kind === "no-plan" && (
        <div class="flex flex-col items-center gap-2">
          <p class="text-center text-lg" data-testid="cook-no-plan">
            {COOK_NO_PLAN_FOR_DATE}
          </p>
          <a href={`/plan?start=${startParam}`} class="text-purple-300 hover:underline">
            Open plan
          </a>
        </div>
      )}

      {view && (
        <div class="space-y-1">
          {view.sections.map((section) => (
            <div>
              {section.source === "exact" ? (
                <p class="text-sm text-emerald-200" data-testid={`cook-source-${section.kind}`}>
                  {evening && <span class="font-semibold">{SESSION_SECTION_LABELS[section.kind]}: </span>}
                  {formatCookExactNote(weekdayOf(section.sourceDayIndex))}
                </p>
              ) : (
                <p class="text-sm text-amber-100" data-testid={`cook-source-${section.kind}`}>
                  {evening && <span class="font-semibold">{SESSION_SECTION_LABELS[section.kind]}: </span>}
                  {formatCookEstimateNote(weekdayOf(section.sourceDayIndex))}{" "}
                  <a href={dayPath(section.sourceDayIndex)} class="text-purple-300 hover:underline">
                    Solve {weekdayOf(section.sourceDayIndex)}
                  </a>
                </p>
              )}
              {section.boundsWarning && (
                <p
                  class="mt-1 rounded-lg border border-amber-400/30 bg-amber-500/10 p-2 text-sm text-amber-100"
                  data-testid={`cook-bounds-${section.kind}`}
                >
                  {COOK_BOUNDS_WARNING}{" "}
                  <a href={dayPath(section.sourceDayIndex)} class="text-purple-300 hover:underline">
                    Open {weekdayOf(section.sourceDayIndex)}
                  </a>
                </p>
              )}
            </div>
          ))}
        </div>
      )}

      {view && !current && (
        <p class="mt-6 text-center text-lg" data-testid="cook-no-steps">
          {COOK_NO_STEPS}
        </p>
      )}

      {view && current && (
        <CookMode
          client:idle
          view={view}
          initialStep={current.number}
          labels={{ sections: SESSION_SECTION_LABELS, timings: STEP_TIMING_LABELS }}
        />
      )}

      {view && (
        <section class="mt-8">
          <h2 class="text-lg font-semibold">{COOK_MODE_LABELS.overview}</h2>
          {view.sections.map((section) => (
            <div class:list={cn("mt-3", evening && "border-t border-white/10 pt-3")}>
              {evening && (
                <h3 class="text-sm font-semibold tracking-wide text-purple-200 uppercase">
                  {SESSION_SECTION_LABELS[section.kind]}
                </h3>
              )}
              {section.entries.map((entry) => (
                <div
                  class="mt-3 rounded-xl border border-white/10 bg-white/5 p-3"
                  data-testid={`cook-entry-${section.kind}-${entry.recipeId}`}
                >
                  <p class="font-medium">
                    {entry.recipeName === null ? (
                      "Unknown recipe"
                    ) : (
                      <a href={`/recipes/${entry.recipeId}`} class="text-purple-300 hover:underline">
                        {entry.recipeName}
                      </a>
                    )}
                  </p>
                  <p class="text-xs text-blue-100/70">{entry.mealsLine}</p>
                  {entry.batches.map((batch) => (
                    <div class="mt-2" data-testid={`cook-batch-${batch.dishId}`}>
                      {batch.heading && <p class="text-xs font-semibold text-blue-100/80">{batch.heading}</p>}
                      {batch.components.map((component) => (
                        <div class="mt-2 border-t border-white/10 pt-2">
                          {component.componentName && <h4 class="text-sm font-medium">{component.componentName}</h4>}
                          <ul class="mt-1 space-y-0.5 text-sm">
                            {component.ingredients.map((ingredient) => (
                              <li>
                                <span class="text-white">{ingredient.productName}</span>
                                <span class="text-blue-100/80">{` ${ingredient.amount}`}</span>
                              </li>
                            ))}
                          </ul>
                          {component.portion && <p class="mt-1 text-sm text-purple-200">{component.portion}</p>}
                        </div>
                      ))}
                    </div>
                  ))}
                </div>
              ))}
              {section.servingNotes.map((note) => (
                <div
                  class="mt-3 rounded-xl border border-emerald-400/20 bg-emerald-500/5 p-3"
                  data-testid={`cook-serving-${note.dayIndex}_${note.mealType}`}
                >
                  <p class="text-sm text-emerald-200">{note.text}</p>
                  {note.portions.map((line) => (
                    <p class="mt-1 text-sm text-purple-200">
                      {line.componentName === null ? line.line : `${line.componentName}: ${line.line}`}
                    </p>
                  ))}
                </div>
              ))}
            </div>
          ))}
        </section>
      )}

      <p class="mt-8 flex flex-wrap justify-center gap-4 text-center text-sm">
        <a
          href={view ? sessionsPath : startDate ? `/plan/sessions?start=${startDate}` : "/plan/sessions"}
          class="text-purple-300 hover:underline"
        >
          Back to sessions
        </a>
        <a href={startDate ? `/plan?start=${startDate}` : "/plan"} class="text-purple-300 hover:underline">
          Back to plan
        </a>
        {startDate && (
          <a href={`/plan/shopping?start=${startDate}`} class="text-purple-300 hover:underline">
            Shopping list
          </a>
        )}
      </p>
    </div>
  </div>
</Layout>
