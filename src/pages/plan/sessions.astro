---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { isIsoDate } from "@/lib/services/meal-plans";
import { getCookingSchedule } from "@/lib/services/cooking";
import {
  SESSIONS_EMPTY,
  SESSIONS_NO_PLAN,
  SESSIONS_NO_PLAN_FOR_DATE,
  SESSIONS_NO_STEPS,
  SESSIONS_UNAVAILABLE,
  formatBatchNote,
  formatEntryMeals,
  formatSessionMinutes,
  formatSessionTitle,
  formatStepDuration,
} from "@/lib/services/cooking-sessions";
import { cookPath } from "@/lib/services/cook-mode";
import { COOK_MODE_LABELS, SESSION_SECTION_LABELS, STEP_TIMING_LABELS } from "@/lib/recipe-labels";
import { cn } from "@/lib/utils";
import type { CookingSchedule, MealPlan } from "@/types";

// S-10: the plan's evening and morning cooking sessions, derived on every read (nothing is stored,
// no solve is needed). Without `start` it is the most recently saved plan's, as on the dashboard.
// A malformed start is 404, a date with no plan says so, and a failed read is 500 — never "no plan".
type State =
  | { kind: "not-found" }
  | { kind: "unavailable" }
  | { kind: "no-plan" }
  | { kind: "loaded"; plan: MealPlan; schedule: CookingSchedule };

const startParam = Astro.url.searchParams.get("start");
const requestedStart = startParam ?? undefined;

let state: State = { kind: "not-found" };
if (requestedStart === undefined || isIsoDate(requestedStart)) {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase) {
    state = { kind: "unavailable" };
  } else {
    try {
      const loaded = await getCookingSchedule(supabase, requestedStart);
      state = loaded ? { kind: "loaded", ...loaded } : { kind: "no-plan" };
    } catch (error) {
      state = { kind: "unavailable" };
      // eslint-disable-next-line no-console -- surfaced in Cloudflare Workers observability logs
      console.error("getCookingSchedule failed on /plan/sessions", error);
    }
  }
}

if (state.kind === "not-found") {
  Astro.response.status = 404;
} else if (state.kind === "unavailable") {
  Astro.response.status = 500;
}

const loaded = state.kind === "loaded" ? state : null;
const startDate = loaded?.plan.startDate ?? (requestedStart && isIsoDate(requestedStart) ? requestedStart : null);
const sessions = loaded?.schedule.sessions ?? [];
// Only read when there are sessions, i.e. when the plan loaded.
const planStart = loaded?.plan.startDate ?? "";
---

<Layout title="Cooking sessions">
  <div class="bg-cosmic min-h-screen p-4 sm:p-8">
    <div class="mx-auto max-w-3xl rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl sm:p-8">
      <h1 class="mb-1 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Cooking sessions
      </h1>
      {loaded && <p class="mb-4 text-sm text-blue-100/80">Plan from {loaded.plan.startDate}</p>}

      {state.kind === "not-found" && (
        <p class="text-center text-lg" data-testid="sessions-not-found">
          Plan not found
        </p>
      )}
      {state.kind === "unavailable" && (
        <p class="text-center text-lg" data-testid="sessions-unavailable">
          {SESSIONS_UNAVAILABLE}
        </p>
      )}
      {state.kind === "no-plan" && (
        <div class="flex flex-col items-center gap-2">
          <p class="text-center text-lg" data-testid="sessions-no-plan">
            {requestedStart ? SESSIONS_NO_PLAN_FOR_DATE : SESSIONS_NO_PLAN}
          </p>
          <a href={requestedStart ? `/plan?start=${requestedStart}` : "/plan"} class="text-purple-300 hover:underline">
            Open plan
          </a>
        </div>
      )}

      {loaded?.plan.meals.length === 0 && (
        <p class="text-center text-lg" data-testid="sessions-empty">
          {SESSIONS_EMPTY}
        </p>
      )}

      {sessions.map((session) => (
        <section
          id={session.key}
          data-testid={`session-${session.key}`}
          class="mt-6 rounded-xl border border-white/10 bg-white/5 p-4"
        >
          <h2 class="text-xl font-semibold">
            {formatSessionTitle(session.date, session.part)}
            <span class="ml-2 text-sm font-normal text-blue-100/60">{session.date}</span>
          </h2>
          <p class="mt-1 text-sm text-blue-100/80" data-testid={`session-minutes-${session.key}`}>
            {formatSessionMinutes(session)}
          </p>
          <a
            href={cookPath(planStart, session.key)}
            class="mt-2 inline-block text-sm font-medium text-purple-300 hover:underline"
            data-testid={`session-cook-${session.key}`}
          >
            {COOK_MODE_LABELS.cookLink}
          </a>

          {session.sections.map((section) => (
            <div class:list={cn("mt-4", session.part === "evening" && "border-t border-white/10 pt-3")}>
              {session.part === "evening" && (
                <h3 class="text-sm font-semibold tracking-wide text-purple-200 uppercase">
                  {SESSION_SECTION_LABELS[section.kind]}
                </h3>
              )}

              {section.entries.length > 0 && (
                <ul class="mt-2 space-y-1 text-sm">
                  {section.entries.map((entry) => (
                    <li>
                      {entry.recipeName === null ? (
                        <span class="font-medium">Unknown recipe</span>
                      ) : (
                        <a href={`/recipes/${entry.recipeId}`} class="font-medium text-purple-300 hover:underline">
                          {entry.recipeName}
                        </a>
                      )}
                      <span class="text-blue-100/70"> · {formatEntryMeals(entry, planStart)}</span>
                      {!entry.hasSteps && <span class="text-amber-100"> · {SESSIONS_NO_STEPS}</span>}
                    </li>
                  ))}
                </ul>
              )}

              {section.batchNotes.map((note) => (
                <p
                  class="mt-2 text-sm text-emerald-200"
                  data-testid={`session-note-${note.meal.dayIndex}_${note.meal.mealType}`}
                >
                  {formatBatchNote(note, planStart)}
                </p>
              ))}

              {section.steps.length > 0 && (
                <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm">
                  {section.steps.map((step) => (
                    <li data-step-id={step.id}>
                      <span class="text-blue-100/70">
                        {step.recipeName}
                        {step.componentName !== null && ` · ${step.componentName}`}
                      </span>
                      <span class="block">{step.instruction}</span>
                      <span class="text-xs text-blue-100/60">
                        <span
                          class:list={cn(
                            "rounded px-1.5 py-0.5",
                            step.timing === "make_ahead"
                              ? "bg-purple-500/20 text-purple-200"
                              : "bg-amber-500/20 text-amber-100",
                          )}
                        >
                          {STEP_TIMING_LABELS[step.timing]}
                        </span>
                        {" · "}
                        {formatStepDuration(step.durationMinutes)}
                      </span>
                    </li>
                  ))}
                </ol>
              )}
            </div>
          ))}
        </section>
      ))}

      <p class="mt-8 flex justify-center gap-4 text-center text-sm">
        <a href={startDate ? `/plan?start=${startDate}` : "/plan"} class="text-purple-300 hover:underline">
          Back to plan
        </a>
        {startDate && (
          <a href={`/plan/shopping?start=${startDate}`} class="text-purple-300 hover:underline">
            Shopping list
          </a>
        )}
        <a href="/dashboard" class="text-purple-300 hover:underline">
          Back to dashboard
        </a>
      </p>
    </div>
  </div>
</Layout>
