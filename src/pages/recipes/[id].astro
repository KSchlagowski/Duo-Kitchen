---
import { z } from "zod";
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { getRecipeDetail } from "@/lib/services/recipes";
import {
  formatCookedLine,
  formatIngredientAmount,
  formatMacroTotals,
  formatRoundingStep,
} from "@/lib/services/recipe-macros";
import { DIVISION_MODE_LABELS, formatMealTypes, STEP_TIMING_LABELS } from "@/lib/recipe-labels";
import { cn } from "@/lib/utils";
import type { RecipeDetail, RecipeDetailStep } from "@/types";

// Three distinct outcomes: a malformed or absent id is 404, a failed read is 500 (never "not found").
// The uuid check runs first so a malformed id never reaches PostgREST, which would answer 22P02.
// z.guid(), not z.uuid(): Postgres accepts any 8-4-4-4-12 hex id, so the stricter RFC version/variant
// check would 404 a library row that the card grid still lists.
type State = { kind: "found"; recipe: RecipeDetail } | { kind: "not-found" } | { kind: "unavailable" };

let state: State = { kind: "not-found" };
const parsedId = z.guid().safeParse(Astro.params.id);
if (parsedId.success) {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  if (!supabase) {
    state = { kind: "unavailable" };
  } else {
    try {
      const recipe = await getRecipeDetail(supabase, parsedId.data);
      state = recipe ? { kind: "found", recipe } : { kind: "not-found" };
    } catch (error) {
      state = { kind: "unavailable" };
      // eslint-disable-next-line no-console -- surfaced in Cloudflare Workers observability logs
      console.error("getRecipeDetail failed", error);
    }
  }
}

if (state.kind === "not-found") {
  Astro.response.status = 404;
} else if (state.kind === "unavailable") {
  Astro.response.status = 500;
}

const recipe = state.kind === "found" ? state.recipe : null;
const stepGroups: { timing: RecipeDetailStep["timing"]; testId: string; steps: RecipeDetailStep[] }[] = recipe
  ? [
      {
        timing: "make_ahead",
        testId: "steps-make-ahead",
        steps: recipe.steps.filter((s) => s.timing === "make_ahead"),
      },
      { timing: "fresh", testId: "steps-fresh", steps: recipe.steps.filter((s) => s.timing === "fresh") },
    ]
  : [];
const showComponentHeadings = recipe?.divisionMode === "per_component";
const title = recipe ? recipe.name : state.kind === "not-found" ? "Recipe not found" : "Recipe unavailable";
---

<Layout title={title}>
  <div class="bg-cosmic min-h-screen p-4 sm:p-8">
    <div class="mx-auto max-w-3xl rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl sm:p-8">
      {state.kind === "not-found" && (
        <p class="text-center text-lg" data-testid="recipe-not-found">
          Recipe not found
        </p>
      )}
      {state.kind === "unavailable" && (
        <p class="text-center text-lg" data-testid="recipe-unavailable">
          Recipe library is unavailable right now
        </p>
      )}
      {recipe && (
        <>
          <p
            class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent"
            data-testid="recipe-name"
            role="heading"
            aria-level="1"
          >
            {recipe.name}
          </p>
          <p class="mt-1 text-sm text-blue-100/80">
            {recipe.cuisine} · {recipe.prepMinutes} min
          </p>
          <p
            class:list={cn("text-sm", recipe.mealTypes.length ? "text-blue-100/80" : "text-blue-100/50")}
            data-testid="recipe-meal-types"
          >
            {formatMealTypes(recipe.mealTypes)}
          </p>
          <p class="mt-1 text-sm text-blue-100/80" data-testid="recipe-division">
            {DIVISION_MODE_LABELS[recipe.divisionMode]}
          </p>

          <h2 class="mt-6 text-lg font-semibold">Whole batch</h2>
          <p class="mt-1 text-sm" data-testid="recipe-total">
            {formatMacroTotals(recipe.totals)}
          </p>

          <h2 class="mt-6 text-lg font-semibold">Ingredients</h2>
          {recipe.components.map((component) => (
            <section class="mt-3 rounded-xl border border-white/10 bg-white/5 p-4">
              {showComponentHeadings && <h3 class="mb-2 font-semibold">{component.name}</h3>}
              <ul class="space-y-2 text-sm">
                {component.ingredients.map((ingredient) => (
                  <li class="flex flex-col gap-0.5 sm:flex-row sm:justify-between sm:gap-4">
                    <span>
                      <span class="text-white">{ingredient.productName}</span>
                      <span class="text-blue-100/80">
                        {" "}
                        {formatIngredientAmount(
                          ingredient.amountG,
                          ingredient.gramsPerPiece,
                          ingredient.allowHalfPieces,
                        )}
                      </span>
                      <span class="text-xs text-blue-100/50">
                        {" "}
                        · {formatRoundingStep(ingredient.effectiveRoundingStepG)}
                        {ingredient.minAmountG !== null && ` · min. ${ingredient.minAmountG} g`}
                      </span>
                    </span>
                    <span class="text-xs text-blue-100/60 sm:text-right">{formatMacroTotals(ingredient.macros)}</span>
                  </li>
                ))}
              </ul>
              {showComponentHeadings && (
                <p class="mt-3 text-sm text-blue-100/80" data-testid="component-total">
                  {formatMacroTotals(component.totals)}
                </p>
              )}
              {component.cookedYieldRatio !== null && component.cookedWeightG !== null && (
                <p class="mt-1 text-sm text-blue-100/80" data-testid="component-cooked">
                  {formatCookedLine(component.rawWeightG, component.cookedWeightG, component.cookedYieldRatio)}
                </p>
              )}
            </section>
          ))}

          {stepGroups.map((group) => (
            <>
              <h2 class="mt-6 text-lg font-semibold" data-testid={group.testId}>
                {STEP_TIMING_LABELS[group.timing]}
              </h2>
              {group.steps.length === 0 ? (
                <p class="mt-1 text-sm text-blue-100/50">—</p>
              ) : (
                <ol class="mt-2 list-decimal space-y-2 pl-5 text-sm">
                  {group.steps.map((step) => (
                    <li>
                      {step.instruction}
                      {step.durationMinutes !== null && (
                        <span class="text-blue-100/60"> ({step.durationMinutes} min)</span>
                      )}
                      {step.componentName !== null && <span class="text-blue-100/60"> — {step.componentName}</span>}
                    </li>
                  ))}
                </ol>
              )}
            </>
          ))}
        </>
      )}

      <p class="mt-8 text-center text-sm">
        <a href="/recipes" class="text-purple-300 hover:underline">
          Back to recipes
        </a>
      </p>
    </div>
  </div>
</Layout>
