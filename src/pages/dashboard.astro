---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { getCurrentHousehold } from "@/lib/services/household";
import { getRecipeLibrarySummary } from "@/lib/services/recipes";
import { getActiveInvite } from "@/lib/services/invites";
import { formatMacroTargets, getHouseholdMacroTargets } from "@/lib/services/macro-targets";
import { PLAN_UNAVAILABLE, formatPlanSummary, getMealPlan } from "@/lib/services/meal-plans";
import type { Household, HouseholdInvite, MacroTargets, MealPlan, RecipeLibrarySummary } from "@/types";

const { user } = Astro.locals;

let household: Household | null = null;
let library: RecipeLibrarySummary | null = null;
let invite: HouseholdInvite | null = null;
let inviteUnavailable = false;
let targets: MacroTargets[] | null = null;
const supabase = createClient(Astro.request.headers, Astro.cookies);
if (supabase) {
  try {
    household = await getCurrentHousehold(supabase);
  } catch (error) {
    // Fall back to the neutral message below instead of failing the page, but keep the failure in the Worker logs.
    // eslint-disable-next-line no-console -- surfaced in Cloudflare Workers observability logs
    console.error("getCurrentHousehold failed", error);
  }
  try {
    library = await getRecipeLibrarySummary(supabase);
  } catch (error) {
    // eslint-disable-next-line no-console -- surfaced in Cloudflare Workers observability logs
    console.error("getRecipeLibrarySummary failed", error);
  }
  try {
    invite = await getActiveInvite(supabase);
  } catch (error) {
    inviteUnavailable = true;
    // eslint-disable-next-line no-console -- surfaced in Cloudflare Workers observability logs
    console.error("getActiveInvite failed", error);
  }
  try {
    targets = await getHouseholdMacroTargets(supabase);
  } catch (error) {
    // eslint-disable-next-line no-console -- surfaced in Cloudflare Workers observability logs
    console.error("getHouseholdMacroTargets failed", error);
  }
}

// Meal plan (S-03): the most recently saved plan. "Start a plan" only when the read succeeded and
// found none -- a failed read must not claim there is no plan.
let plan: MealPlan | null = null;
let planFailed = supabase === null;
if (supabase) {
  try {
    plan = await getMealPlan(supabase);
  } catch (error) {
    planFailed = true;
    // eslint-disable-next-line no-console -- surfaced in Cloudflare Workers observability logs
    console.error("getMealPlan failed", error);
  }
}
const planLabel = planFailed ? PLAN_UNAVAILABLE : formatPlanSummary(plan);
const planLinkLabel = !planFailed && !plan ? "Start a plan" : "Open plan";

const memberCount = household?.members.length ?? 0;
const householdLabel = household
  ? `Household: ${household.id.slice(0, 8)} · ${memberCount} member${memberCount === 1 ? "" : "s"}`
  : "Household information is unavailable right now.";
const libraryLabel = library
  ? `Library: ${library.recipeCount} recipes · ${library.productCount} products`
  : "Recipe library is unavailable right now.";
const myTargets = targets?.find((t) => t.userId === user?.id) ?? null;
const targetsLabel =
  targets === null
    ? "Targets are unavailable right now."
    : myTargets
      ? `Targets: ${formatMacroTargets(myTargets)}`
      : "Targets: not set";
// "Set targets" only when the read succeeded and found no row: a failed read must not claim "not set".
const targetsLinkLabel = targets === null ? "Open targets" : myTargets ? "Edit targets" : "Set targets";

const isLinked = memberCount >= 2;
// Built from the request origin so the link works in dev, preview and production unconfigured.
const inviteLink = invite ? `${Astro.url.origin}/join?code=${invite.code}` : null;
const inviteLabel = isLinked
  ? "Linked with your partner."
  : inviteUnavailable
    ? "Invite information is unavailable right now."
    : invite
      ? `Invite code: ${invite.code}`
      : "No invite code yet.";

const notice = Astro.url.searchParams.get("error");
const joined = Astro.url.searchParams.get("joined") === "1";
---

<Layout title="Dashboard">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Dashboard
      </h1>
      <p class="text-blue-100/80">
        Welcome, <span class="font-semibold text-white">{user?.email}</span>
      </p>
      <p class="mt-2 text-sm text-blue-100/80" data-testid="household">
        {householdLabel}
      </p>
      <p class="mt-2 text-sm text-blue-100/80" data-testid="library">
        {libraryLabel}
      </p>
      <p class="mt-2 text-sm text-blue-100/80" data-testid="targets">
        {targetsLabel}
      </p>
      <a href="/targets" class="text-sm text-purple-300 hover:underline">
        {targetsLinkLabel}
      </a>

      <!-- Meal plan (S-03) -->
      <p class="mt-2 text-sm text-blue-100/80" data-testid="plan">
        {planLabel}
      </p>
      <a href="/plan" class="text-sm text-purple-300 hover:underline">
        {planLinkLabel}
      </a>

      {joined && (
        <p class="mt-4 rounded-lg border border-emerald-400/30 bg-emerald-500/10 p-3 text-sm text-emerald-200">
          You've joined the household.
        </p>
      )}
      {notice && (
        <p class="mt-4 rounded-lg border border-red-400/30 bg-red-500/10 p-3 text-sm text-red-200">{notice}</p>
      )}

      <p class="mt-4 text-sm text-blue-100/80" data-testid="invite">
        {inviteLabel}
      </p>
      {inviteLink && (
        /* Selectable text, not a clipboard island: this slice adds no React components. */
        <p class="mt-1 text-xs break-all text-blue-100/60">{inviteLink}</p>
      )}
      {!isLinked && !inviteUnavailable && (
        <form method="POST" action="/api/household/invite" class="mt-3">
          <button
            type="submit"
            class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
          >
            {invite ? "Generate new code" : "Generate invite code"}
          </button>
        </form>
      )}

      <p class="mt-4 text-sm text-blue-100/50">This page is only for authenticated users.</p>
      <form method="POST" action="/api/auth/signout" class="mt-6">
        <button
          type="submit"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Sign out
        </button>
      </form>
    </div>
  </div>
</Layout>
