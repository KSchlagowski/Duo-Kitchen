---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { getCurrentHousehold } from "@/lib/services/household";
import {
  MEAL_TYPES,
  PLAN_DAYS,
  PLAN_UNAVAILABLE,
  addDays,
  defaultPlanStart,
  formatPlanSummary,
  getMealPlan,
  isIsoDate,
  weekdayLabel,
} from "@/lib/services/meal-plans";
import {
  SOLVE_SAVED_PLAN_HINT,
  SOLVE_STATUS_UNAVAILABLE,
  emptyPlanSolveStatuses,
  formatCookDayNote,
  formatFromBatchNote,
  formatGroupSolvePrompt,
  formatPlanDayStatus,
  formatPlanGroupLine,
  formatSameDayBatchNote,
  formatSolvePrompt,
  getPlanSolveStatuses,
  needsSolvePrompt,
} from "@/lib/services/day-solutions";
import { MEAL_TYPE_LABELS } from "@/lib/recipe-labels";
import { getRecipeCards } from "@/lib/services/recipes";
import { cn } from "@/lib/utils";
import type {
  Household,
  MealPlan,
  MealType,
  PlanDayIndex,
  PlanDaySolveStatus,
  PlanEater,
  PlanMealRecord,
  RecipeCard,
} from "@/types";

const { user } = Astro.locals;

const startParam = Astro.url.searchParams.get("start");
const requestedStart = startParam && isIsoDate(startParam) ? startParam : undefined;

// Three independent reads. The form is rendered only when ALL of them succeed: a save from a blank
// grid would overwrite the stored plan, and a missing household would remap partner meals to Both.
let recipes: RecipeCard[] | null = null;
let household: Household | null = null;
let plan: MealPlan | null = null;
let planFailed = false;
const supabase = createClient(Astro.request.headers, Astro.cookies);
if (supabase) {
  try {
    recipes = await getRecipeCards(supabase);
  } catch (error) {
    // eslint-disable-next-line no-console -- surfaced in Cloudflare Workers observability logs
    console.error("getRecipeCards failed on /plan", error);
  }
  try {
    household = await getCurrentHousehold(supabase);
  } catch (error) {
    // eslint-disable-next-line no-console -- surfaced in Cloudflare Workers observability logs
    console.error("getCurrentHousehold failed on /plan", error);
  }
  try {
    plan = await getMealPlan(supabase, requestedStart);
  } catch (error) {
    planFailed = true;
    // eslint-disable-next-line no-console -- surfaced in Cloudflare Workers observability logs
    console.error("getMealPlan failed on /plan", error);
  }
} else {
  planFailed = true;
}

const unavailable: string[] = [];
if (recipes === null) unavailable.push("Recipes are unavailable right now.");
if (household === null) unavailable.push("Household information is unavailable right now.");
if (planFailed) unavailable.push(PLAN_UNAVAILABLE);
const canEdit = unavailable.length === 0;

// S-04 solve status per day. Its own try/catch and never part of canEdit: a failing solve read must
// not hide or disable the grid (FR-020). A date with no saved plan has only empty days.
let solveStatuses: Record<PlanDayIndex, PlanDaySolveStatus> | null = null;
if (supabase && canEdit) {
  try {
    solveStatuses = plan ? await getPlanSolveStatuses(supabase, plan) : emptyPlanSolveStatuses();
  } catch (error) {
    // eslint-disable-next-line no-console -- surfaced in Cloudflare Workers observability logs
    console.error("getPlanSolveStatuses failed on /plan", error);
  }
}

const isLinked = (household?.members.length ?? 0) >= 2;
const startDate = requestedStart ?? plan?.startDate ?? defaultPlanStart();
const summary = planFailed ? PLAN_UNAVAILABLE : formatPlanSummary(plan);

const slotKey = (dayIndex: PlanDayIndex, mealType: MealType) => `${dayIndex}_${mealType}`;
const slotRank = (meal: PlanMealRecord) => meal.dayIndex * MEAL_TYPES.length + MEAL_TYPES.indexOf(meal.mealType);
const weekdayOf = (dayIndex: PlanDayIndex) => weekdayLabel(addDays(startDate, dayIndex));

const mealsBySlot = new Map<string, PlanMealRecord>();
// S-08: the meals eating from each dish, in slot order. A dish with more than one is a shared batch.
const mealsByDish = new Map<string, PlanMealRecord[]>();
for (const meal of plan?.meals ?? []) {
  mealsBySlot.set(slotKey(meal.dayIndex, meal.mealType), meal);
  mealsByDish.set(meal.dishId, [...(mealsByDish.get(meal.dishId) ?? []), meal]);
}
for (const members of mealsByDish.values()) {
  members.sort((a, b) => slotRank(a) - slotRank(b));
}

// A saved batch in canonical star form: every member but the lowest slot names the lowest slot, the
// lowest names none. That round-trips through save_meal_plan's union-find and is stable across saves.
function batchOf(meal: PlanMealRecord | undefined): string {
  const lead = meal ? mealsByDish.get(meal.dishId)?.[0] : undefined;
  return meal && lead && lead !== meal ? slotKey(lead.dayIndex, lead.mealType) : "";
}

// The cook-day / from-batch note of a slot of a shared batch, or null for a batch of its own.
function batchNoteOf(meal: PlanMealRecord | undefined): string | null {
  const members = meal ? (mealsByDish.get(meal.dishId) ?? []) : [];
  if (!meal || members.length < 2) return null;
  const cookDay = members[0].dayIndex;
  const otherDays = [...new Set(members.map((m) => m.dayIndex))].filter((d) => d !== cookDay);
  if (meal.dayIndex !== cookDay) return formatFromBatchNote(weekdayOf(cookDay));
  if (otherDays.length > 0) return formatCookDayNote(otherDays.map(weekdayOf));
  return formatSameDayBatchNote(members.filter((m) => m !== meal).map((m) => MEAL_TYPE_LABELS[m.mealType]));
}

function eaterOf(meal: PlanMealRecord | undefined): PlanEater {
  const eaterUserId = meal?.eaterUserId ?? null;
  if (eaterUserId === null) return "both";
  return eaterUserId === user?.id ? "me" : "partner";
}

const eaterOptions: { value: PlanEater; label: string }[] = [
  { value: "both", label: "Both" },
  { value: "me", label: "Me" },
  ...(isLinked ? [{ value: "partner" as const, label: "Partner" }] : []),
];

const saved = Astro.url.searchParams.get("saved") === "1";
const notice = Astro.url.searchParams.get("error");
// S-08: a save that turned stale shares into fresh batches (formatUnsharedNotice in /api/plan).
const softNotice = saved ? Astro.url.searchParams.get("notice") : null;

const selectClass =
  "w-full rounded-lg border border-white/20 bg-slate-900/60 px-2 py-1.5 text-sm text-white focus:border-purple-300 focus:outline-none";
---

<Layout title="Meal plan">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-5xl rounded-2xl border border-white/10 bg-white/10 p-6 text-white backdrop-blur-xl sm:p-8">
      <h1 class="mb-2 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-3xl font-bold text-transparent">
        Meal plan
      </h1>
      <p
        class:list={cn("mb-6 text-center text-sm", plan ? "text-white" : "text-blue-100/60")}
        data-testid="plan-summary"
      >
        {summary}
      </p>
      {/* S-09: outside the grid form, so following it never posts unsaved grid edits. */}
      {plan && (
        <p class="-mt-4 mb-6 text-center text-sm">
          <a href={`/plan/shopping?start=${plan.startDate}`} class="text-purple-300 hover:underline">
            Shopping list
          </a>
          {/* S-10 */}
          <a
            href={`/plan/sessions?start=${plan.startDate}`}
            class="ml-3 text-purple-300 hover:underline"
            data-testid="plan-sessions-link"
          >
            Cooking sessions
          </a>
        </p>
      )}

      {saved && (
        <p class="mb-4 rounded-lg border border-emerald-400/30 bg-emerald-500/10 p-3 text-sm text-emerald-200">
          Saved.
        </p>
      )}
      {softNotice && (
        <p
          class="mb-4 rounded-lg border border-amber-400/30 bg-amber-500/10 p-3 text-sm text-amber-200"
          data-testid="plan-notice"
        >
          {softNotice}
        </p>
      )}
      {notice && (
        <p class="mb-4 rounded-lg border border-red-400/30 bg-red-500/10 p-3 text-sm text-red-200">{notice}</p>
      )}
      {unavailable.map((message) => (
        <p class="mb-4 rounded-lg border border-red-400/30 bg-red-500/10 p-3 text-sm text-red-200">{message}</p>
      ))}

      {/* Switching dates is a GET: the save form's date is fixed to the grid it shows, so saving can
          never copy this grid over another date's stored plan. */}
      <form method="GET" action="/plan" class="mb-6 flex flex-wrap items-end gap-2">
        <label class="flex flex-col gap-1 text-sm text-blue-100/80">
          Plan starting
          <input
            type="date"
            name="start"
            required
            value={startDate}
            class="rounded-lg border border-white/20 bg-white/10 px-3 py-2 text-white focus:border-purple-300 focus:outline-none"
          />
        </label>
        <button
          type="submit"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Open
        </button>
      </form>

      {canEdit && recipes && (
        <form method="POST" action="/api/plan" class="flex flex-col gap-6">
          <input type="hidden" name="start_date" value={startDate} />

          <div class="grid gap-4 md:grid-cols-3">
            {PLAN_DAYS.map((day) => {
              const date = addDays(startDate, day);
              return (
                <section class="flex flex-col gap-3 rounded-xl border border-white/10 bg-white/5 p-4">
                  <h2 class="font-semibold">
                    {weekdayLabel(date)} <span class="text-sm font-normal text-blue-100/60">{date}</span>
                  </h2>
                  <label class="flex flex-col gap-1 text-xs text-blue-100/70">
                    Whole day for
                    <select name={`day${day}_eater`} class:list={selectClass}>
                      <option value="">— each meal as set —</option>
                      {eaterOptions.map((option) => (
                        <option value={option.value}>{option.label}</option>
                      ))}
                    </select>
                  </label>

                  {MEAL_TYPES.map((mealType) => {
                    const meal = mealsBySlot.get(`${day}_${mealType}`);
                    const suggested = recipes.filter((recipe) => recipe.mealTypes.includes(mealType));
                    const other = recipes.filter((recipe) => !recipe.mealTypes.includes(mealType));
                    const eater = eaterOf(meal);
                    const batch = batchOf(meal);
                    const batchNote = batchNoteOf(meal);
                    return (
                      <fieldset class="flex flex-col gap-1 border-t border-white/10 pt-3">
                        <legend class="text-sm font-medium text-blue-100/90">{MEAL_TYPE_LABELS[mealType]}</legend>
                        <label class="sr-only" for={`d${day}_${mealType}_recipe`}>
                          {MEAL_TYPE_LABELS[mealType]} recipe
                        </label>
                        <select
                          id={`d${day}_${mealType}_recipe`}
                          name={`d${day}_${mealType}_recipe`}
                          class:list={selectClass}
                        >
                          <option value="">— empty —</option>
                          {suggested.length > 0 && (
                            <optgroup label="Suggested">
                              {suggested.map((recipe) => (
                                <option value={recipe.id} selected={meal?.recipeId === recipe.id}>
                                  {recipe.name}
                                </option>
                              ))}
                            </optgroup>
                          )}
                          {other.length > 0 && (
                            <optgroup label="Other recipes">
                              {other.map((recipe) => (
                                <option value={recipe.id} selected={meal?.recipeId === recipe.id}>
                                  {recipe.name}
                                </option>
                              ))}
                            </optgroup>
                          )}
                        </select>
                        <label class="flex items-center gap-2 text-xs text-blue-100/70">
                          For
                          <select name={`d${day}_${mealType}_eater`} class:list={selectClass}>
                            {eaterOptions.map((option) => (
                              <option value={option.value} selected={option.value === eater}>
                                {option.label}
                              </option>
                            ))}
                          </select>
                        </label>
                        <label class="flex flex-col gap-1 text-xs text-blue-100/70">
                          Share a batch with
                          <select name={`d${day}_${mealType}_batch`} class:list={selectClass}>
                            <option value="">Cook a fresh batch</option>
                            {PLAN_DAYS.map((otherDay) => (
                              <optgroup label={weekdayOf(otherDay)}>
                                {MEAL_TYPES.filter((otherType) => otherDay !== day || otherType !== mealType).map(
                                  (otherType) => (
                                    <option
                                      value={slotKey(otherDay, otherType)}
                                      selected={batch === slotKey(otherDay, otherType)}
                                    >
                                      {weekdayOf(otherDay)} {MEAL_TYPE_LABELS[otherType]}
                                    </option>
                                  ),
                                )}
                              </optgroup>
                            ))}
                          </select>
                        </label>
                        {batchNote && (
                          <p class="text-xs text-purple-200" data-testid={`batch-${day}_${mealType}`}>
                            {batchNote}
                          </p>
                        )}
                      </fieldset>
                    );
                  })}
                </section>
              );
            })}
          </div>

          <button
            type="submit"
            class="self-center rounded-lg border border-white/20 bg-white/10 px-6 py-2 text-sm transition-colors hover:bg-white/20"
          >
            Save plan
          </button>
        </form>
      )}

      {/* S-04: a sibling AFTER the grid form, never inside it. Forms cannot nest, and a formaction
          button in the grid would post unsaved grid edits that the solve route ignores. */}
      {canEdit && !solveStatuses && (
        <p class="mt-6 rounded-lg border border-red-400/30 bg-red-500/10 p-3 text-sm text-red-200">
          {SOLVE_STATUS_UNAVAILABLE}
        </p>
      )}
      {canEdit && solveStatuses && (
        <section class="mt-8 flex flex-col gap-3">
          <h2 class="text-lg font-semibold">Macros</h2>
          <div class="grid gap-4 md:grid-cols-3">
            {PLAN_DAYS.map((day) => {
              const status = solveStatuses[day];
              const weekday = weekdayOf(day);
              const isGroup = status.groupDayIndexes.length > 1;
              const solveForm = (
                <form method="POST" action="/api/plan/solve">
                  <input type="hidden" name="start_date" value={startDate} />
                  <input type="hidden" name="day_index" value={String(day)} />
                  <button
                    type="submit"
                    class="rounded-lg border border-white/20 bg-white/10 px-3 py-1.5 text-sm transition-colors hover:bg-white/20"
                  >
                    Solve macros
                  </button>
                </form>
              );
              return (
                <section class="flex flex-col gap-2 rounded-xl border border-white/10 bg-white/5 p-4">
                  <h3 class="font-semibold">{weekday}</h3>
                  <p
                    class:list={cn("text-sm", status.kind === "stale" ? "text-amber-200" : "text-blue-100/80")}
                    data-testid={`day-status-${day}`}
                  >
                    {formatPlanDayStatus(status)}
                  </p>
                  {isGroup && (
                    <p class="text-xs text-blue-100/70" data-testid={`day-group-${day}`}>
                      {formatPlanGroupLine(status.groupDayIndexes.filter((d) => d !== day).map(weekdayOf))}
                    </p>
                  )}
                  {needsSolvePrompt(status) ? (
                    <div class="flex flex-col items-start gap-2 rounded-lg border border-purple-300/30 bg-purple-500/10 p-3">
                      <p class="text-sm text-purple-100" data-testid={`day-prompt-${day}`}>
                        {isGroup
                          ? formatGroupSolvePrompt(status.groupDayIndexes.map(weekdayOf))
                          : formatSolvePrompt(weekday)}
                      </p>
                      {solveForm}
                    </div>
                  ) : (
                    status.kind !== "empty" && solveForm
                  )}
                  {plan && status.kind !== "empty" && (
                    <a href={`/plan/day?start=${startDate}&day=${day}`} class="text-xs text-purple-300 hover:underline">
                      View day →
                    </a>
                  )}
                </section>
              );
            })}
          </div>
          <p class="text-center text-xs text-blue-100/60">{SOLVE_SAVED_PLAN_HINT}</p>
        </section>
      )}

      <p class="mt-8 text-center text-sm">
        <a href="/dashboard" class="text-purple-300 hover:underline">
          Back to dashboard
        </a>
      </p>
    </div>
  </div>
</Layout>
